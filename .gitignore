# Vite
.vite/

# Local media & large binaries (Vite serves public/ at URL root)
# Tracked exceptions: README + .gitkeep only under public/media/
public/media/**
!public/media/
!public/media/.gitkeep
!public/media/README.md
!public/media/track/
!public/media/track/.gitkeep
!public/media/car/
!public/media/car/.gitkeep

# Alternate media root (if used)
media/**
!media/
!media/.gitkeep
!media/README.md

# OpenF1 replay cache (CLI ingest); README under data/replays/ stays tracked
data/replays/*.json
public/replays/*.json
.vercel
.env*
