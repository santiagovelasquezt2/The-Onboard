# Local media & large binaries (Vite serves public/ at URL root)
# Tracked exceptions: docs/placeholders plus the exact production runtime GLBs.
public/media/**
!public/media/
!public/media/.gitkeep
!public/media/README.md
!public/media/onboard.mp4
!public/media/landing/
!public/media/landing/*.mp4
!public/media/track/
!public/media/track/.gitkeep
!public/media/track/montreal-runtime-v2.glb
!public/media/car/
!public/media/car/.gitkeep
!public/media/car/amg-w14-runtime-v2.glb
!public/media/helmet/
!public/media/helmet/README.md
!public/media/helmet/russell-glass-shell.glb

# Alternate media root (if used)
media/**
!media/
!media/.gitkeep
!media/README.md

# OpenF1 replay cache (CLI ingest); README under data/replays/ stays tracked
data/replays/*.json
public/replays/*.json
!public/replays/2024-montreal-q-d63-lap22.json
.vercel
